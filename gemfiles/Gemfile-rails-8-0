source "https://rubygems.org"

gemspec path: ".."

gem "rails", '~> 8.0'

group :test do
  gem "rack-test"
  gem "rspec-rails"
  gem "database_cleaner"
end

platforms :ruby do
  gem "sqlite3", "~> 2.8"
end

group :development do
  gem 'bundler'
  gem 'rake'
  gem 'rspec'
  gem 'rubocop'
  gem 'rubocop-rake'
  gem 'rubocop-rspec'
end
